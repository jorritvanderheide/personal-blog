{
  "printWidth": 80,
  "tabWidth": 2,
  "useTabs": false,
  "semi": false,
  "bracketSpacing": true,
  "arrowParens": "avoid",
  "htmlWhitespaceSensitivity": "ignore",
  "proseWrap": "always",
  "embeddedLanguageFormatting": "auto",
  "plugins": ["prettier-plugin-go-template", "prettier-plugin-tailwindcss"],
  "tailwindStylesheet": "./assets/css/main.css",
  "overrides": [
    {
      "files": ["*.html"],
      "options": {
        "parser": "go-template"
      }
    }
  ]
}
